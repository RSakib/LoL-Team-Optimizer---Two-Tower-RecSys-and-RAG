LOL_DATA_DIR=data
LOL_PROCESSED_DIR=data/processed
LOL_CHROMA_DIR=.chroma
LOL_MODEL_DIR=artifacts/two_tower
LOL_TEAM_MODEL_DIR=artifacts/team_model
LOL_TEAM_MODEL=artifacts/team_model/model.pt
LOL_TEAM_MODEL_METADATA=artifacts/team_model/metadata.json
LOL_TWO_TOWER_DEVICE=cpu
LOL_RAG_RRF_WEIGHT=0.35
LOL_API_URL=http://127.0.0.1:8001
LOL_UI_BACKEND=local
# Optional: defaults to rag_embeddings.npz beside the selected profile JSONL.
# LOL_RAG_EMBEDDINGS_PATH=data/processed/rag_embeddings.npz
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
SCOUT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# SCOUT_DEVICE defaults to zero_gpu on ZeroGPU Spaces, cpu elsewhere.
SCOUT_MAX_INPUT_TOKENS=8192
SCOUT_MAX_NEW_TOKENS=192
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=16
